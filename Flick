        lbl.Size = UDim2.new(1, 0, 0, 25)
        lbl.Position = UDim2.new(0, 0, 0, yOffset)
        lbl.BackgroundTransparency = 1
        lbl.Text = "• " .. name
        lbl.TextColor3 = C.text
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Font = Enum.Font.GothamMedium
        lbl.TextSize = 14
        yOffset = yOffset + 25
    end
    FriendDisplay.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

AddFriendBtn.MouseButton1Click:Connect(function()
    local name = FriendInput.Text:gsub("^%s*(.-)%s*$", "%1")
    if name == "" then return end
    local player = Players:FindFirstChild(name)
    if not player then 
        notify("Player not found!", C.red) 
        return 
    end
    for _, v in pairs(FriendList) do if v == name then return end end
    table.insert(FriendList, name)
    FriendInput.Text = ""
    UpdateFriendDisplay()
    if player then updatePlayerHighlight(player) end
end)

RemoveFriendBtn.MouseButton1Click:Connect(function()
    local name = FriendInput.Text:gsub("^%s*(.-)%s*$", "%1")
    if name == "" then return end
    for i, v in pairs(FriendList) do
        if v == name then
            table.remove(FriendList, i)
            FriendInput.Text = ""
            UpdateFriendDisplay()
            local player = Players:FindFirstChild(name)
            if player then updatePlayerHighlight(player) end
            return
        end
    end
    notify("Friend not found in list!", C.red)
end)

BackBtn.MouseButton1Click:Connect(function() FriendsUI.Visible = false end)

-- Hotkeys
UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.T then CycleTarget() end
    if input.KeyCode == Enum.KeyCode.F then 
        Settings.ShowFOV = not Settings.ShowFOV
        FOVFrame.Visible = Settings.ShowFOV
        notify("FOV Circle: " .. (Settings.ShowFOV and "ON" or "OFF"), C.accent)
    end
end)

-- Main Aimbot Loop
RunService.RenderStepped:Connect(function()
    if Settings.AimbotEnabled then
        local target = getClosestPlayer()
        if target and target.Character then
            local targetPart = target.Character:FindFirstChild(Settings.TargetPart)
            if not targetPart then targetPart = target.Character:FindFirstChild("HumanoidRootPart") end
            if targetPart then
                local targetPos = targetPart.Position
                local targetCFrame = CFrame.new(Camera.CFrame.Position, targetPos)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 1 - Settings.Smoothness)
            end
        end
    end
end)

