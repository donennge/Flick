local HANDLERS = {
    AimbotEnabled = function(v) Settings.AimbotEnabled = v; notify("Aimbot  "..(v and "ON" or "OFF"), v and C.green or C.accent) end,
    VisibleCheck = function(v) Settings.VisibleCheck = v; notify("Wall Check  "..(v and "ON" or "OFF"), v and C.green or C.accent) end,
    FOVLevel = function(v) 
        Settings.FOV = v
        FOVFrame.Size = UDim2.new(0, v * 2, 0, v * 2)
    end,
    Smoothness = function(v) Settings.Smoothness = v end,
    
    WallhackEnabled = function(v) 
        Settings.WallhackEnabled = v
        updateAllWH()
        notify("Wallhack  "..(v and "ON" or "OFF"), v and C.green or C.accent) 
    end,
    ShowFOV = function(v) 
        Settings.ShowFOV = v
        FOVFrame.Visible = v
        notify("FOV Circle  "..(v and "ON" or "OFF"), v and C.green or C.accent)
    end,
    
    CycleTarget = function() CycleTarget() end,
    OpenFriends = function() 
        FriendsUI.Visible = not FriendsUI.Visible 
        if FriendsUI.Visible then UpdateFriendDisplay() end
    end,
}

Changed.Event:Connect(function(id, value)
    local h = HANDLERS[id]
    if h then pcall(h, value) end
end)

